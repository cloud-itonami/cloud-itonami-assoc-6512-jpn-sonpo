(ns association-facts
  (:export [main association-covered? entry-count entry-field topic-count topic by-topic-count by-topic-id]))
(defn association-covered? [a :string] :bool (string=? a "sonpo"))
(defn entry-count [a :string] :i64 (if (association-covered? a) 2 0))
(defn valid-entry? [a :string i :i64] :bool
  (if (association-covered? a) (if (= i 0) true (if (= i 1) true false)) false))
(defn entry-field [a :string i :i64 f :string] [:option :string]
  (if (valid-entry? a i)
    (if (= i 0)
      (cond
        (string=? f "id") (option-some-of [:option :string] "sonpo.code-of-conduct")
        (string=? f "title") (option-some-of [:option :string] "日本損害保険協会 行動規範 (GIAJ Code of Conduct)")
        (string=? f "association") (option-some-of [:option :string] "sonpo")
        (string=? f "isic") (option-some-of [:option :string] "6512")
        (string=? f "country") (option-some-of [:option :string] "JPN")
        (string=? f "kind") (option-some-of [:option :string] "self-regulatory-code")
        (string=? f "url") (option-some-of [:option :string] "https://www.sonpo.or.jp/about/guideline/ev7otb0000000cjp-att/action_kodokihan.pdf")
        (string=? f "url-provenance") (option-some-of [:option :string] "official-association-site")
        (string=? f "established-date") (option-some-of [:option :string] "1991-10-17")
        (string=? f "last-revised-date") (option-some-of [:option :string] "2024-03-21")
        (string=? f "retrieved-at") (option-some-of [:option :string] "2026-07-14")
        :else (option-none-of [:option :string]))
      (cond
        (string=? f "id") (option-some-of [:option :string] "sonpo.antitrust-compliance-guideline")
        (string=? f "title") (option-some-of [:option :string] "損害保険会社の独占禁止法遵守のための指針 (Guidelines for Antitrust Law Compliance by General Insurance Companies)")
        (string=? f "association") (option-some-of [:option :string] "sonpo")
        (string=? f "isic") (option-some-of [:option :string] "6512")
        (string=? f "country") (option-some-of [:option :string] "JPN")
        (string=? f "kind") (option-some-of [:option :string] "self-regulatory-code")
        (string=? f "url") (option-some-of [:option :string] "https://www.sonpo.or.jp/about/guideline/ev7otb0000000cjp-att/action_dokkinho.pdf")
        (string=? f "url-provenance") (option-some-of [:option :string] "official-association-site")
        (string=? f "last-revised-date") (option-some-of [:option :string] "2026-01")
        (string=? f "retrieved-at") (option-some-of [:option :string] "2026-07-14")
        :else (option-none-of [:option :string])))
    (option-none-of [:option :string])))
(defn topic-count [a :string i :i64] :i64 (if (valid-entry? a i) (if (= i 0) 3 2) 0))
(defn topic [a :string i :i64 ti :i64] [:option :string]
  (if (valid-entry? a i)
    (if (= i 0)
      (if (= ti 0) (option-some-of [:option :string] "ethics")
        (if (= ti 1) (option-some-of [:option :string] "member-conduct")
          (if (= ti 2) (option-some-of [:option :string] "human-rights") (option-none-of [:option :string]))))
      (if (= ti 0) (option-some-of [:option :string] "antitrust")
        (if (= ti 1) (option-some-of [:option :string] "fair-competition") (option-none-of [:option :string]))))
    (option-none-of [:option :string])))
(defn by-topic-count [a :string t :string] :i64
  (if (association-covered? a)
    (if (string=? t "ethics") 1
      (if (string=? t "member-conduct") 1
        (if (string=? t "human-rights") 1
          (if (string=? t "antitrust") 1 (if (string=? t "fair-competition") 1 0)))))
    0))
(defn by-topic-id [a :string t :string i :i64] [:option :string]
  (if (association-covered? a)
    (if (= i 0)
      (if (string=? t "ethics") (entry-field a 0 "id")
        (if (string=? t "member-conduct") (entry-field a 0 "id")
          (if (string=? t "human-rights") (entry-field a 0 "id")
            (if (string=? t "antitrust") (entry-field a 1 "id")
              (if (string=? t "fair-competition") (entry-field a 1 "id") (option-none-of [:option :string]))))))
      (option-none-of [:option :string]))
    (option-none-of [:option :string])))
(defn main [] :i64 0)
